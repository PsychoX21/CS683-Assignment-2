#include "cache.h"

#define maxRRPV            3
#define NUM_LEADER_SETS    32
#define LEADER_SET_STRIDE  (L2C_SET / NUM_LEADER_SETS)

#ifndef DYN_THRESHOLD
#define DYN_THRESHOLD 0.20
#endif

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

uint64_t leader_instr_acc = 0;
uint64_t leader_instr_miss = 0;
uint64_t leader_total_acc = 0;
uint64_t leader_total_miss = 0;

bool irrip_active = false;

bool is_leader_set(uint32_t set) {
    return (set % LEADER_SET_STRIDE == 0);
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP state for L2C, threshold: " << DYN_THRESHOLD << endl;
    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
    leader_instr_acc = 0;
    leader_instr_miss = 0;
    leader_total_acc = 0;
    leader_total_miss = 0;
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (int i = 0; i < L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }

    bool irrip = is_leader_set(set) ? false : irrip_active;

    while (true) {
        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV && current_set[i].prefetch)
                return i;
        }

        if (irrip) {
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && current_set[i].instruction == 0)
                    return i;
            }
        }

        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV)
                return i;
        }

        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{

    if (irrip_active && !is_leader_set(set)) {
        if (hit) {
            if (isInstruction)
                l2_rrpv[set][way] = 0;
            else
                l2_rrpv[set][way] = 1;
        } else {
            if (type == PREFETCH)
                l2_rrpv[set][way] = maxRRPV;
            else if (isInstruction)
                l2_rrpv[set][way] = 1;
            else
                l2_rrpv[set][way] = maxRRPV - 1;
        }
    } else {
        if (is_leader_set(set)) {
            leader_total_acc++;
            if (!hit) leader_total_miss++;
            if (isInstruction) {
                leader_instr_acc++;
                if (!hit) leader_instr_miss++;
            }
            irrip_active = (double)(leader_instr_acc + leader_instr_miss) / (double)(leader_total_acc + leader_total_miss) > DYN_THRESHOLD;
        }
        
        if (hit) {
            l2_rrpv[set][way] = 0;
        } else {
            if (type == PREFETCH)
                l2_rrpv[set][way] = maxRRPV;
            else
                l2_rrpv[set][way] = maxRRPV - 1;
        }
    }
}

void CACHE::l2c_replacement_final_stats()
{
    uint64_t denom = leader_total_acc + leader_total_miss;
    double ratio = denom > 0 ? (double)(leader_instr_acc + leader_instr_miss) / (double)denom : 0.0;
    cout << "Dynamic I-RRIP Final Stats:" << endl;
    cout << "Leader Total Acc+Miss: " << denom << endl;
    cout << "Leader Instr Acc+Miss: " << (leader_instr_acc + leader_instr_miss) << endl;
    cout << "Ratio: " << ratio << ", Threshold: " << DYN_THRESHOLD << endl;
    cout << "Winning Policy: " << (ratio > DYN_THRESHOLD ? "I-RRIP" : "SRRIP") << endl;
}
