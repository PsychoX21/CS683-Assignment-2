#include "cache.h"
#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <cmath>

#define IP_TRACKER_COUNT     64
#define MASK_IP              0xFFFF
#define PATTERN_TABLE_SIZE   512
#define SIG_MASK             (PATTERN_TABLE_SIZE - 1)

#define FILTER_SETS          64
#define FILTER_WAYS          4

#ifndef SPP_T_HIGH
#define SPP_T_HIGH 0.40
#endif

#ifndef SPP_T_MID
#define SPP_T_MID 0.30
#endif

#ifndef SPP_T_LOW
#define SPP_T_LOW 0.15
#endif

struct IP_TRACKER {
    uint64_t ip;
    uint64_t last_cl_addr;
    int64_t  last_stride;
    uint32_t signature;
    uint8_t  uniform_conf;
    uint32_t lru;

    void reset() {
        last_cl_addr = 0;
        last_stride  = 0;
        signature    = 0;
        uniform_conf = 0;
    }
};

struct PATTERN_ENTRY {
    int64_t  predicted_stride;
    uint8_t  confidence;
};

struct FILTER_SET {
    uint64_t cl_addr[FILTER_WAYS];
    bool     valid[FILTER_WAYS];
    bool     useful[FILTER_WAYS];
    uint8_t  lru[FILTER_WAYS];
};

static IP_TRACKER    trackers[IP_TRACKER_COUNT];
static PATTERN_ENTRY pattern_table[PATTERN_TABLE_SIZE];
static FILTER_SET    pref_filter[FILTER_SETS];

static uint64_t total_pref_issued       = 0;
static uint64_t total_pref_useful       = 0;
static uint64_t uniform_pref_issued     = 0;
static uint64_t non_uniform_pref_issued = 0;

static uint64_t epoch_pref_issued       = 0;
static uint64_t epoch_pref_useful       = 0;

static inline uint32_t encode_stride(int64_t s)
{
    uint32_t sign  = (s < 0) ? 0x40 : 0x00;
    int64_t  abs_s = (s < 0) ? -s : s;
    uint32_t mag   = (uint32_t)((abs_s > 63 ? 63 : abs_s) & 0x3F);
    return sign | mag;
}

static inline uint64_t hash_ip(uint64_t raw_ip)
{
    return ((raw_ip >> 2) ^ (raw_ip >> 8)) & MASK_IP;
}

static bool is_in_filter(uint64_t pf_cl)
{
    uint32_t set = pf_cl % FILTER_SETS;
    for (int w = 0; w < FILTER_WAYS; w++) {
        if (pref_filter[set].valid[w] && pref_filter[set].cl_addr[w] == pf_cl)
            return true;
    }
    return false;
}

static void record_filter(uint64_t pf_cl)
{
    uint32_t set = pf_cl % FILTER_SETS;
    int way = -1;

    for (int w = 0; w < FILTER_WAYS; w++) {
        if (pref_filter[set].valid[w] && pref_filter[set].cl_addr[w] == pf_cl) {
            way = w;
            break;
        }
    }
    if (way == -1) {
        for (int w = 0; w < FILTER_WAYS; w++) {
            if (!pref_filter[set].valid[w]) {
                way = w;
                break;
            }
        }
    }
    if (way == -1) {
        for (int w = 0; w < FILTER_WAYS; w++) {
            if (pref_filter[set].lru[w] == FILTER_WAYS - 1) {
                way = w;
                break;
            }
        }
    }

    for (int w = 0; w < FILTER_WAYS; w++) {
        if (pref_filter[set].lru[w] < pref_filter[set].lru[way])
            pref_filter[set].lru[w]++;
    }
    pref_filter[set].cl_addr[way] = pf_cl;
    pref_filter[set].valid[way]   = true;
    pref_filter[set].useful[way]  = false;
    pref_filter[set].lru[way]     = 0;
}

static void check_filter(uint64_t cl_addr)
{
    uint32_t set = cl_addr % FILTER_SETS;
    for (int w = 0; w < FILTER_WAYS; w++) {
        if (pref_filter[set].valid[w] && pref_filter[set].cl_addr[w] == cl_addr) {
            if (!pref_filter[set].useful[w]) {
                total_pref_useful++;
                epoch_pref_useful++;
                pref_filter[set].useful[w] = true;
            }
            for (int i = 0; i < FILTER_WAYS; i++) {
                if (pref_filter[set].lru[i] < pref_filter[set].lru[w])
                    pref_filter[set].lru[i]++;
            }
            pref_filter[set].lru[w] = 0;
            return;
        }
    }
}

static double get_accuracy()
{
    if (epoch_pref_issued == 0)
        return 0.50;
    return (double)epoch_pref_useful / (double)epoch_pref_issued;
}

static uint32_t get_degree(double accuracy)
{
    if (SPP_T_HIGH <= 0.0) return 4;
    if (SPP_T_HIGH >= 10.0) return 1;

    if (epoch_pref_issued < 200) return 3;
    if (accuracy >= SPP_T_HIGH) return 4;
    if (accuracy >= SPP_T_MID)  return 3;
    if (accuracy >= SPP_T_LOW)  return 2;
    return 1;
}

static bool issue_single_prefetch(CACHE* cache, uint64_t ip, uint64_t addr, uint64_t pf_address)
{
    uint64_t pf_cl = pf_address >> LOG2_BLOCK_SIZE;

    if (is_in_filter(pf_cl))
        return true;

    if (cache->PQ.occupancy >= cache->PQ.SIZE)
        return false;

    int fill_level = (cache->MSHR.occupancy < (cache->MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;

    int success = cache->prefetch_line(ip, addr, pf_address, fill_level, 0);
    if (success) {
        total_pref_issued++;
        epoch_pref_issued++;
        record_filter(pf_cl);

        if (epoch_pref_issued >= 4096) {
            epoch_pref_issued >>= 1;
            epoch_pref_useful >>= 1;
        }
        return true;
    }
    return false;
}

static void issue_uniform_prefetch(CACHE* cache, uint64_t ip, uint64_t addr,
                                   uint64_t cl_addr, int64_t stride, uint32_t degree)
{
    for (uint32_t i = 0; i < degree; i++) {
        uint64_t pf_address = (cl_addr + (stride * (i + 1))) << LOG2_BLOCK_SIZE;
        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;

        if (!issue_single_prefetch(cache, ip, addr, pf_address))
            break;
        uniform_pref_issued++;
    }
}

static void issue_non_uniform_prefetch(CACHE* cache, uint64_t ip, uint64_t addr,
                                       uint64_t cl_addr, const IP_TRACKER& tracker,
                                       uint32_t degree)
{
    uint64_t curr_cl  = cl_addr;
    uint32_t curr_sig = tracker.signature;

    for (uint32_t i = 0; i < degree; i++) {
        uint8_t min_conf = (i == 0) ? 2 : 3;
        if (pattern_table[curr_sig].confidence < min_conf)
            break;

        int64_t pred_stride = pattern_table[curr_sig].predicted_stride;
        if (pred_stride == 0 || std::abs(pred_stride) >= 64)
            break;

        uint64_t pf_cl      = curr_cl + pred_stride;
        uint64_t pf_address = pf_cl << LOG2_BLOCK_SIZE;

        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;

        if (!issue_single_prefetch(cache, ip, addr, pf_address))
            break;
        non_uniform_pref_issued++;

        curr_cl  = pf_cl;
        curr_sig = ((curr_sig << 3) ^ encode_stride(pred_stride)) & SIG_MASK;
    }
}

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "L1D Stride Pattern Prefetcher (SPP) initialized" << std::endl;

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        trackers[i].reset();
        trackers[i].lru = i;
    }

    for (int i = 0; i < PATTERN_TABLE_SIZE; i++) {
        pattern_table[i].predicted_stride = 0;
        pattern_table[i].confidence       = 0;
    }

    for (int s = 0; s < FILTER_SETS; s++) {
        for (int w = 0; w < FILTER_WAYS; w++) {
            pref_filter[s].cl_addr[w] = 0;
            pref_filter[s].valid[w]   = false;
            pref_filter[s].useful[w]  = false;
            pref_filter[s].lru[w]     = w;
        }
    }

    total_pref_issued       = 0;
    total_pref_useful       = 0;
    uniform_pref_issued     = 0;
    non_uniform_pref_issued = 0;

    epoch_pref_issued       = 0;
    epoch_pref_useful       = 0;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip,
                                   uint8_t cache_hit, uint8_t type,
                                   uint8_t critical_ip_flag)
{
    if (type == PREFETCH || type == WRITEBACK)
        return;

    uint64_t cl_addr   = addr >> LOG2_BLOCK_SIZE;
    uint64_t masked_ip = hash_ip(ip);

    if (type == LOAD)
        check_filter(cl_addr);

    int index = -1;
    for (index = 0; index < IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == masked_ip)
            break;
    }

    if (index == IP_TRACKER_COUNT) {
        for (index = 0; index < IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT - 1))
                break;
        }

        trackers[index].reset();
        trackers[index].ip           = masked_ip;
        trackers[index].last_cl_addr = cl_addr;

        for (int i = 0; i < IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;
        return;
    }

    int64_t stride = (int64_t)cl_addr - (int64_t)trackers[index].last_cl_addr;
    if (stride == 0)
        return;

    uint32_t prev_sig = trackers[index].signature;

    bool stride_matched = (stride == trackers[index].last_stride);
    if (stride_matched) {
        if (trackers[index].uniform_conf < 3)
            trackers[index].uniform_conf++;
    } else {
        if (trackers[index].uniform_conf > 0)
            trackers[index].uniform_conf--;
    }

    if (pattern_table[prev_sig].predicted_stride == stride) {
        if (pattern_table[prev_sig].confidence < 7)
            pattern_table[prev_sig].confidence++;
    } else {
        if (pattern_table[prev_sig].confidence > 0)
            pattern_table[prev_sig].confidence--;
        if (pattern_table[prev_sig].confidence == 0) {
            pattern_table[prev_sig].predicted_stride = stride;
            pattern_table[prev_sig].confidence       = 1;
        }
    }

    uint32_t new_sig = ((prev_sig << 3) ^ encode_stride(stride)) & SIG_MASK;
    trackers[index].signature    = new_sig;
    trackers[index].last_stride  = stride;
    trackers[index].last_cl_addr = cl_addr;

    double   accuracy = get_accuracy();
    uint32_t degree   = get_degree(accuracy);

    bool non_uniform_override = (pattern_table[new_sig].confidence >= 3 &&
                                 pattern_table[new_sig].predicted_stride != stride);

    if (stride_matched && trackers[index].uniform_conf >= 2 && !non_uniform_override) {
        issue_uniform_prefetch(this, ip, addr, cl_addr, stride, degree);
    } else {
        uint64_t old_non_uniform = non_uniform_pref_issued;
        issue_non_uniform_prefetch(this, ip, addr, cl_addr, trackers[index], degree);
        if (non_uniform_pref_issued == old_non_uniform && stride_matched && trackers[index].uniform_conf >= 1) {
            issue_uniform_prefetch(this, ip, addr, cl_addr, stride, 1);
        }
    }

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr,
                                      uint32_t set, uint32_t way,
                                      uint8_t prefetch,
                                      uint64_t v_evicted_addr,
                                      uint64_t evicted_addr,
                                      uint32_t metadata_in)
{
    if (evicted_addr != 0) {
        uint64_t evicted_cl = evicted_addr >> LOG2_BLOCK_SIZE;
        uint32_t f_set = evicted_cl % FILTER_SETS;
        for (int w = 0; w < FILTER_WAYS; w++) {
            if (pref_filter[f_set].valid[w] && pref_filter[f_set].cl_addr[w] == evicted_cl) {
                pref_filter[f_set].valid[w]  = false;
                pref_filter[f_set].useful[w] = false;
                break;
            }
        }
    }
}

void CACHE::l1d_prefetcher_final_stats()
{
    std::cout << "SPP Final Stats:" << std::endl;
    std::cout << "Total Prefetches Issued:     " << total_pref_issued << std::endl;
    std::cout << "Uniform Prefetches Issued:   " << uniform_pref_issued << std::endl;
    std::cout << "Non-Uniform Pref Issued:     " << non_uniform_pref_issued << std::endl;
    std::cout << "Total Prefetches Useful:     " << total_pref_useful << std::endl;
    double lifetime_accuracy = (total_pref_issued == 0) ? 0.0 :
        ((double)total_pref_useful / (double)total_pref_issued * 100.0);
    std::cout << "Accuracy: " << std::fixed << std::setprecision(2)
              << lifetime_accuracy << "%" << std::endl;
}